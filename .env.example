# =========================
# DJANGO
# =========================

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost


# =========================
# BASE DE DONNÉES
# =========================

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Si nous passons plus tard à PostgreSQL/MySQL :
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432


# =========================
# MÉTÉO
# =========================

WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=


# =========================
# INTELLIGENCE ARTIFICIELLE
# =========================

AI_API_URL=
AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AGRI_RAG_MODEL=gemini-3.5-flash-lite
# Score cosine du retriever sparse; à calibrer avec le corpus vérifié du projet.
AGRI_RAG_RELEVANCE_THRESHOLD=0.18

# La collecte de documents n'utilise aucune clé de recherche.
# GEMINI_API_KEY est facultative : sans elle, les documents peuvent tout de même
# être importés et enregistrés; l'extraction sera simplement indisponible.
